# Base URL of the API. The default (/api/v1) uses the same origin: the Vite dev server and
# Nginx forward /api to Django, so the browser never makes cross-origin requests.
# VITE_API_URL=/api/v1

# Google OAuth client ID for "Continuar con Google" (public value, same as the API's
# GOOGLE_CLIENT_ID). Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=
