server {
    listen 80;
    root /usr/share/nginx/html;

    # The browser only talks to this origin; API calls are forwarded to Django.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Built files have a hash in their name, so they can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: the app's own routes get index.html with a 200.
    location ~ ^/(login|registro|demo|recuperar|restablecer|gastos|fijos|categorias)?/?$ {
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    # Real files (robots.txt, icons...). Anything else is a 404 for search engines, but still gets
    # the app, which sends the visitor to the home page instead of a dead end.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
        error_page 404 /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/xml;
}
